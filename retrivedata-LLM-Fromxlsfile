import pandas as pd
import ollama

df = pd.read_excel("employees.xlsx")

while True:
    question = input("Ask Question: ")

    if question.lower() == "exit":
        break

    prompt = f"""
    Excel Data:
    {df.to_string(index=False)}

    Question:
    {question}
    """

    response = ollama.chat(
        model='llama3.2',
        messages=[
            {'role': 'user', 'content': prompt}
