# 17. File Handling
# -------------------------------------

print("17. FILE HANDLING")

with open("student.txt", "w") as file:
    file.write("Python Learning Project")

print("Data Written to File")

with open("student.txt", "r") as file:
    content = file.read()

print("File Content:")
print(content)

print()

# -------------------------------------
# 18. JSON Handling
# -------------------------------------

print("18. JSON")

student_data = {
    "id": 101,
    "name": "Rahul"
}

with open("student.json", "w") as file:
    json.dump(student_data, file)

print("JSON File Created")

with open("student.json", "r") as file:
    data = json.load(file)

print("JSON Data =", data)

print()

# -------------------------------------
# 19. Date and Time
# -------------------------------------

print("19. DATE & TIME")

print("Current Date Time:")
print(datetime.now())

print()

# -------------------------------------
# 20. Break Continue Pass
# -------------------------------------

print("20. BREAK")

for i in range(1, 10):

    if i == 5:
        print("Breaking at 5")
        break

    print(i)

print()

print("CONTINUE")

for i in range(1, 6):

    if i == 3:
        continue

    print(i)

print()

print("PASS")

for i in range(3):
    pass

print("Pass Executed")

print()

