print()

# -------------------------------------
# 3. Operators
# -------------------------------------

print("3. OPERATORS")

a = 10
b = 5

print("Addition =", a + b)
print("Subtraction =", a - b)
print("Multiplication =", a * b)
print("Division =", a / b)
print()

# -------------------------------------
# 4. Conditional Statements
# -------------------------------------

print("4. CONDITIONAL STATEMENTS")

marks = int(input("Enter Marks: "))

if marks >= 90:
    print("Grade A")
elif marks >= 75:
    print("Grade B")
else:
    print("Grade C")

print()

# -------------------------------------
# 5. Loops
# -------------------------------------

print("5. FOR LOOP")

for i in range(1, 6):
    print("Number =", i)

print()

print("5. WHILE LOOP")

count = 1

while count <= 3:
    print("Count =", count)
    count += 1

print()

# -------------------------------------
# 6. Functions
# -------------------------------------

print("6. FUNCTIONS")

def calculate_square(num):
    print("Calculating square...")
    return num * num

result = calculate_square(5)

print("Square =", result)
print()

# -------------------------------------
# 7. OOP
# -------------------------------------

print("7. OBJECT ORIENTED PROGRAMMING")

class Student:

    def __init__(self, sid, name):
        print("Constructor Called")
        self.sid = sid
        self.name = name

    def display(self):
        print("Student ID :", self.sid)
        print("Student Name :", self.name)

s1 = Student(101, "Rahul")

s1.display()

print()

# -------------------------------------
# 8. Inheritance
# -------------------------------------

print("8. INHERITANCE")

class GraduateStudent(Student):

    def show_course(self):
        print("Course: Python")

g1 = GraduateStudent(102, "Priya")

g1.display()
g1.show_course()

print()

