import tensorflow as tf
import numpy as np
from ollama import chat

hours = np.array([1,2,3,4,5], dtype=float)
marks = np.array([30,45,60,75,90], dtype=float)

model = tf.keras.Sequential([
    tf.keras.layers.Dense(1)
])

model.compile(
    optimizer='adam',
    loss='mse'
)

model.fit(hours, marks, epochs=500, verbose=0)

user_hours = float(input("Enter study hours: "))

prediction = model.predict([user_hours])

predicted_marks = prediction[0][0]

response = chat(
    model='llama3',
    messages=[
        {
            'role': 'user',
            'content':
            f'Explain prediction of {predicted_marks:.2f} marks for a student who studied {user_hours} hours.'
        }
    ]
)

print("\nPredicted Marks:", predicted_marks)
print("\nAI Explanation:")
print(response['message']['content'])



