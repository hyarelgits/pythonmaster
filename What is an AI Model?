python example for Logistic Regression


from sklearn.linear_model import LogisticRegression

# Training Data
X = [[1], [2], [3], [4], [5], [6]]
y = [0, 0, 0, 1, 1, 1]

# Create Model
model = LogisticRegression()

# Train
model.fit(X, y)

# Predict
result = model.predict([[5]])

print(result)


